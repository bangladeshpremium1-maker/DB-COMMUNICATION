rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() { 
      return request.auth != null; 
    }
    
    function isValidId(id) { 
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    function existing() { 
      return resource.data; 
    }
    
    // Entity Validations
    function isValidUser(data) {
      return data.displayName is string && data.email is string;
    }
    
    function isValidChat(data) {
      return data.type is string && data.participants is list;
    }
    
    function isValidMessage(data) {
      return data.text is string && data.senderId is string;
    }

    function isValidCall(data) {
      return data.callerId is string && data.receiverId is string;
    }

    // Rules
    match /users/{userId} {
      function isOwner() { return request.auth.uid == userId; }
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isOwner() && isValidUser(incoming());
    }
    
    match /chats/{chatId} {
      allow read, write: if isSignedIn() && (chatId == 'new' || request.auth.uid in resource.data.participants || request.auth.uid in request.resource.data.participants);
      
      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }
    
    match /calls/{callId} {
      allow read: if isSignedIn() && isValidId(callId) && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.receiverId);
      allow list: if isSignedIn() && (resource.data.callerId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(callId) && isValidCall(incoming()) && (request.auth.uid == incoming().callerId);
      allow update: if isSignedIn() && isValidId(callId) && isValidCall(incoming()) && (request.auth.uid == existing().callerId || request.auth.uid == existing().receiverId);
    }
  }
}
